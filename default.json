{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges"
  ],
  "description": "Groups minor and patch updates together in a single PR, and treat NPM 0.x.x updates as major updates.",
  "minimumReleaseAge": "14 days",
  "prHourlyLimit": 10,
  "timezone": "Europe/Oslo",
  "labels": ["Renovate"],
  "assignees": ["haakemon"],
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions",
        "nuget"
      ],
      "groupName": "{{manager}} non-major dependencies",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm non-major dependencies",
      "matchCurrentVersion": ">=1.0.0",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupSlug": "npm-minor-patch"
    },
    {
      // https://docs.renovatebot.com/key-concepts/minimum-release-age/#which-registries-support-release-timestamps
      "description": "Do not require Minimum Release Age for update types that lack release timestamp support.",
      "matchDatasources": [
        "docker"
      ],
      "prBodyNotes": [
        "⚠️ Release timestamp support is lacking for Docker updates, except from Docker Hub. Therefore, we set timestamp-optional for Docker updates."
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // https://docs.renovatebot.com/key-concepts/minimum-release-age/#which-update-types-take-minimumreleaseage-into-account
      "description": "Updates does not support release timestamps.",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "digest",
        "replacement"
      ],
      "prBodyNotes": [
        "⚠️ Release timestamp support is not available for this update, verify new version manually."
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
