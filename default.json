{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges"
  ],
  "ignorePresets": [
    "security:minimumReleaseAgeNpm"
  ],
  "description": "Groups minor and patch updates together in a single PR, and treat NPM 0.x.x updates as major updates.",
  "minimumReleaseAge": "14 days",
  "prHourlyLimit": 10,
  "timezone": "Europe/Oslo",
  "labels": ["Renovate"],
  "assignees": ["haakemon"],
  "packageRules": [
    {
      "matchManagers": [
        "docker-compose",
        "dockerfile",
        "github-actions",
        "nuget"
      ],
      "groupName": "{{manager}} non-major dependencies",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupSlug": "{{manager}}-minor-patch"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm non-major dependencies",
      "matchCurrentVersion": ">=1.0.0",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupSlug": "npm-minor-patch"
    },
    {
      // https://docs.renovatebot.com/key-concepts/minimum-release-age/#which-registries-support-release-timestamps
      "description": "Docker updates from other registries than Docker Hub does not support release timestamps.",
      "matchDatasources": ["docker"],
      "prBodyNotes": [
        "⚠️ Release timestamp support for Docker is only supported on Docker Hub, timestamp is set to optional for this update."
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      // https://docs.renovatebot.com/key-concepts/minimum-release-age/#which-update-types-take-minimumreleaseage-into-account
      "description": "Lockfile updates, digest updates and replacements does not support release timestamps.",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "digest",
        "pin",
        "replacement"
      ],
      "prBodyNotes": [
        "⚠️ Release timestamp support is not available for this update type, timestamp is set to optional for this update."
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
